# Application
NODE_ENV=development

# Public site URL used in referral links (production only)
NEXT_PUBLIC_APP_URL=https://jambnaija.vercel.app

# Turso (libSQL) — preferred for production and shared environments
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local / test fallback (SQLite file)
# DATABASE_URL=file:local.db
# For Vitest isolated runs the code supports USE_MEMORY_DB=1

# Authentication — required in production
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-char-random-string
JWT_SECRET=replace-with-at-least-32-char-random-string

# Never commit real .env files. Never expose secrets via NEXT_PUBLIC_*.

# Optional: enable one-time admin bootstrap
# ADMIN_BOOTSTRAP_KEY=replace-with-long-random-key
